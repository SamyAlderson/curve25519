# .gitignore
# ignore node_modules and rust target dirs
node_modules/
target/

# ignore IDE config files
.idea/
.vscode/

# ignore build artifacts
dist/
build/

# ignore docker containers
.docker/

# ignore macos and linux build artifacts
.DS_Store
Thumbs.db
.cache/
.cache/

# ignore rust build artifacts
Cargo.lock
target/